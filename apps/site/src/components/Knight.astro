---
/*
 * A knight as the owner drew it, with live eyes over the drawn ones: the same eyes, states and geometry as the app
 * (apps/web/src/lib/knight-eyes.ts, and ui/avatar.ts's way of drawing them), drawn here once, at build time. What a
 * knight is doing shows in its eyes alone; the drawing itself never moves. An idle knight may follow the pointer
 * (`follow`); a busy one keeps its eyes on its work.
 */
import { ART, SHOWN } from "../../../web/src/lib/knight-eyes.ts";
import { DRAWINGS, LARGE } from "../lib/knights.ts";

type Look = keyof typeof DRAWINGS;
type Expression = keyof typeof SHOWN;

interface Props {
  art: Look;
  /** What a screen reader hears: who it is and what it is doing. */
  label: string;
  expression?: Expression;
  size?: "s" | "m" | "l" | "xl";
  follow?: boolean;
}

const { art, label, expression = "idle", size = "m", follow = false } = Astro.props;
const shown = SHOWN[expression];
const n1 = (value: number) => String(Math.round(value * 10) / 10);
// A knight's own moment in the blink and the glance, from its name, so a row of them doesn't blink as one.
let beat = 0;
for (const ch of art) beat = (beat * 31 + ch.charCodeAt(0)) % 5;

const eyes = ART[art].eyes.map(([x, y, r, slit]) => {
  const [gx, gy] = [x + shown.gaze[0] * r, y + shown.gaze[1] * r];
  return { x, y, r, slit, gx, gy };
});
const [x0, y0, x1] = ART[art].box;
const askWidth = 0.24 * (x1 - x0);
const askAt = `translate(${n1(x1 - askWidth * 0.95)} ${n1(Math.max(4, y0 - 6))}) scale(${n1(askWidth / 44)})`;
const drawing = DRAWINGS[art];
const large = size === "l" || size === "xl" ? LARGE[art] : undefined;
---

<span
  class:list={["knight", `kn-${size}`, `kn-t${beat}`]}
  role="img"
  aria-label={label}
  data-expression={expression}
  data-follow={follow ? "" : undefined}
>
  <img
    src={drawing.src}
    srcset={large ? `${drawing.src} 288w, ${large.src} 576w` : undefined}
    sizes={large ? (size === "xl" ? "176px" : "120px") : undefined}
    width={drawing.width}
    height={drawing.height}
    alt=""
    decoding="async"
    draggable="false"
  />
  <svg class="kn-live" viewBox="0 0 768 768" aria-hidden="true" focusable="false">
    {
      eyes.map(({ x, y, r, slit, gx, gy }) => (
        <>
          <circle cx={n1(x)} cy={n1(y)} r={n1(r * 1.3)} fill={slit} />
          <g class="kn-look">
            <g class="kn-gaze">
              <g class="kn-eye">
                {shown.eyes === "happy" ? (
                  <path d={`M${n1(gx - 1.1 * r)} ${n1(gy + 0.42 * r)}Q${n1(gx)} ${n1(gy - 1.15 * r)} ${n1(gx + 1.1 * r)} ${n1(gy + 0.42 * r)}`} fill="none" stroke="#ffffff" stroke-width={n1(0.62 * r)} stroke-linecap="round" />
                ) : shown.eyes === "shut" ? (
                  <path d={`M${n1(gx - 1.1 * r)} ${n1(gy)}Q${n1(gx)} ${n1(gy + 0.8 * r)} ${n1(gx + 1.1 * r)} ${n1(gy)}`} fill="none" stroke="#ffffff" stroke-width={n1(0.55 * r)} stroke-linecap="round" />
                ) : (
                  <circle cx={n1(gx)} cy={n1(gy + (shown.eyes === "low" ? 0.12 * r : 0))} r={n1(r * (shown.eyes === "wide" ? 1.18 : shown.eyes === "low" ? 0.86 : 1))} fill="#ffffff" />
                )}
              </g>
            </g>
          </g>
        </>
      ))
    }
    {
      expression === "asking" && (
        <g transform={askAt}>
          <g class="kn-ask">
            <path d="M8 0H36Q44 0 44 8V24Q44 32 36 32H24L16 40L17 32H8Q0 32 0 24V8Q0 0 8 0Z" fill="#a8373a" stroke="#2a2120" stroke-width="1.6" />
            <path d="M22 7V18" stroke="#ffffff" stroke-width="4" stroke-linecap="round" />
            <circle cx="22" cy="25" r="2.4" fill="#ffffff" />
          </g>
        </g>
      )
    }
  </svg>
</span>
